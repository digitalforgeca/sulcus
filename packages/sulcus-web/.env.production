# Production environment — baked into the Next.js static export at build time.
# This is the ONLY source of truth for production API URLs.
# Do NOT set NEXT_PUBLIC_SULCUS_SERVER_URL in Azure Static Web App settings —
# it will be ignored anyway since Next.js bakes NEXT_PUBLIC_* at build time.

NEXT_PUBLIC_SULCUS_SERVER_URL=https://api.sulcus.ca
NEXT_PUBLIC_KEYCLOAK_URL=https://sulcus-keycloak.calmstone-a7a24a97.westus.azurecontainerapps.io
NEXT_PUBLIC_KEYCLOAK_REALM=sulcus
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=sulcus-web-public
