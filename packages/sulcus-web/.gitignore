# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — local overrides stay out of git
.env
.env.local
.env.*.local
# Production and development env files ARE committed (public URLs only, no secrets)
!.env.production
!.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
