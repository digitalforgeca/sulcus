{
  "name": "@digitalforgestudios/openclaw-sulcus",
  "version": "7.2.1",
  "description": "Thermodynamic memory for OpenClaw agents. Context Engine with constructive assembly and overflow prevention. SIU v2 pipeline (SIVU/SICU/SILU), Apache AGE knowledge graph, reactive triggers, multi-signal recall, interaction-based decay, local-first architecture with cloud sync.",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "plugin",
    "memory",
    "sulcus",
    "thermodynamic",
    "knowledge-graph",
    "age-graph",
    "siu-pipeline",
    "ai-agent",
    "ai-memory",
    "long-term-memory",
    "heat-decay",
    "cross-agent",
    "curator",
    "interaction-decay"
  ],
  "author": "Digital Forge Studios <contact@sulcus.ca>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/digitalforgeca/sulcus",
    "directory": "packages/openclaw-sulcus"
  },
  "homepage": "https://sulcus.ca",
  "bugs": {
    "url": "https://github.com/digitalforgeca/sulcus/issues"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=1.0.0"
    },
    "build": {
      "openclawVersion": "2026.5.2"
    }
  },
  "files": [
    "index.ts",
    "wasm/",
    "openclaw.plugin.json",
    "hooks.defaults.json",
    "README.md"
  ],
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "koffi": "^2.9.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.0"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx esbuild index.ts --bundle --platform=node --target=node18 --outfile=index.js --external:openclaw --external:koffi --external:@anthropic-ai/openclaw-plugin-sdk --format=cjs",
    "prepublishOnly": "npm run build"
  }
}
