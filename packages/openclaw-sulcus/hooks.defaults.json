{
    "$schema": "hooks-config",
    "version": 1,
    "hooks": {
        "before_prompt_build": {
            "action": "auto_recall",
            "enabled": false,
            "limit": 5,
            "minScore": 0.3
        },
        "before_agent_start": {
            "action": "auto_recall",
            "enabled": false,
            "limit": 5,
            "minScore": 0.3,
            "_deprecated": "Use before_prompt_build instead. Legacy compat only."
        },
        "agent_end": {
            "action": "sivu_auto_capture",
            "enabled": true,
            "min_store_confidence": 0.4,
            "fallback_on_error": true,
            "_note": "SIVU gate: 0.4 = relaxed (captures technical/architectural content). 0.5 = strict (more noise rejection). < 0.3 not recommended."
        },
        "after_tool_call": {
            "action": "auto_error_capture",
            "enabled": true
        },
        "before_compaction": {
            "action": "pre_compaction_capture",
            "enabled": true
        }
    },
    "tools": {
        "memory_recall": {
            "enabled": true
        },
        "memory_store": {
            "enabled": true
        },
        "memory_status": {
            "enabled": true
        },
        "consolidate": {
            "enabled": false
        },
        "export_markdown": {
            "enabled": false
        },
        "import_markdown": {
            "enabled": false
        },
        "evaluate_triggers": {
            "enabled": false
        },
        "memory_delete": {
            "enabled": false
        },
        "memory_get": {
            "enabled": true
        },
        "memory_list": {
            "enabled": true
        },
        "memory_update": {
            "enabled": true
        },
        "memory_profile": {
            "enabled": true
        },
        "siu_label": {
            "enabled": false
        },
        "siu_status": {
            "enabled": false
        },
        "siu_retrain": {
            "enabled": false
        },
        "trigger_feedback": {
            "enabled": false
        },
        "__sulcus_workflow__": {
            "enabled": true
        },
        "session_store": {
            "enabled": true
        },
        "session_recall": {
            "enabled": true
        },
        "memory_inspect": {
            "enabled": true
        }
    },
    "dream": {
        "enabled": true,
        "sessionInterval": 10,
        "minGapHours": 24,
        "minMemories": 50,
        "consolidateMinHeat": 0.1,
        "_note": "Dream auto-trigger: fires consolidation every N sessions if enough time has passed and memory count exceeds threshold. All gates are cheap local checks except the final memory-count API call."
    }
}
