FROM rust:latest AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

# Cache-bust
ARG CACHE_BUST=1
RUN echo "cache_bust=$CACHE_BUST" > /tmp/.cache_bust

COPY . .
RUN cargo build --release -p sulcus-server 2>&1

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates libssl3 curl && rm -rf /var/lib/apt/lists/*

# Install ONNX Runtime 1.23.2 (minimum version required by ort 2.0.0-rc.11)
RUN curl -sL https://github.com/microsoft/onnxruntime/releases/download/v1.23.2/onnxruntime-linux-x64-1.23.2.tgz \
    | tar xz -C /tmp && \
    cp /tmp/onnxruntime-linux-x64-1.23.2/lib/libonnxruntime.so.1.23.2 /usr/local/lib/ && \
    ln -sf libonnxruntime.so.1.23.2 /usr/local/lib/libonnxruntime.so.1 && \
    ln -sf libonnxruntime.so.1 /usr/local/lib/libonnxruntime.so && \
    ldconfig && \
    rm -rf /tmp/onnxruntime-*

WORKDIR /app
COPY --from=builder /app/target/release/sulcus-server .
EXPOSE 3000
CMD ["./sulcus-server"]
