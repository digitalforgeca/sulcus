{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "sulcus-memory",
  "version": "0.1.0",
  "description": "SULCUS proactive memory and context engine for persistent cross-session recall and knowledge capture.",
  "author": {
    "name": "Digital Forge Studios Inc.",
    "email": "support@sulcus.ca",
    "url": "https://sulcus.ca"
  },
  "homepage": "https://sulcus.ca",
  "repository": "https://github.com/digitalforgeca/sulcus",
  "license": "Proprietary",
  "keywords": [
    "memory",
    "context",
    "persistent-memory",
    "semantic-search",
    "knowledge-graph",
    "mcp"
  ],
  "extensions": {
    "com.openai": {
      "apps": "./.app.json",
      "skills": "./skills/",
      "onboardingSkill": "./skills/sulcus-setup/SKILL.md",
      "mcpServers": {
        "sulcus": {
          "type": "streamable-http",
          "url": "https://api.sulcus.ca/mcp"
        }
      },
      "interface": {
        "displayName": "SULCUS",
        "shortDescription": "Persistent memory & context",
        "longDescription": "SULCUS provides persistent cross-session memory, proactive context recall, and durable knowledge capture.",
        "developerName": "Digital Forge Studios Inc.",
        "category": "Other",
        "websiteURL": "https://sulcus.ca",
        "supportURL": "https://sulcus.ca/support",
        "privacyPolicyURL": "https://sulcus.ca/privacy",
        "termsOfServiceURL": "https://sulcus.ca/terms",
        "defaultPrompt": [
          "Recall relevant context from SULCUS memory.",
          "Save this discussion to my SULCUS memory."
        ],
        "brandColor": "#6366F1"
      }
    }
  }
}
