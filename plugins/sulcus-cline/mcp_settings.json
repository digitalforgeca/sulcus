{
  "mcpServers": {
    "sulcus": {
      "command": "sulcus",
      "args": ["mcp-proxy"],
      "alwaysAllow": [
        "build_context",
        "search_memory",
        "expand_memory",
        "store_memory",
        "update_memory",
        "list_memories",
        "list_namespaces",
        "use_skill",
        "project_map",
        "find_symbol",
        "get_outline",
        "get_references"
      ],
      "disabled": false
    }
  }
}
